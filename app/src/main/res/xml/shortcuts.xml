<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_recording"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_new_recording_short"
        android:shortcutLongLabel="@string/shortcut_new_recording_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.yourdomain.voicescribe"
            android:targetClass="com.yourdomain.voicescribe.app.MainActivity">
            <extra android:name="autostart_recording" android:value="true" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
