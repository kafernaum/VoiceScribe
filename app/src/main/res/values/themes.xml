<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose (VoiceScribeTheme) owns all real theming. This XML theme
         only needs to exist for the window background shown before Compose
         takes over, and for the launcher/OS chrome. -->
    <style name="Theme.VoiceScribe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
    </style>
</resources>
